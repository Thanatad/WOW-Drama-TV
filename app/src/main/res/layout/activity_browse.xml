<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinematic_bg"
    android:orientation="vertical">

    <!-- Top Category Bar -->
    <HorizontalScrollView
        android:id="@+id/browseTopBarScroll"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="#131620"
        android:elevation="10dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/browseTopBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Native Poster Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browseGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="18dp"
            android:descendantFocusability="afterDescendants"
            android:scrollbars="none" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/browseLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent_red"
            android:visibility="gone" />

        <!-- Error / Fallback -->
        <LinearLayout
            android:id="@+id/browseError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#E6161922"
            android:elevation="15dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/browseErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โหลดรายการหนังไม่สำเร็จ"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="ลองใหม่อีกครั้ง หรือเปิดโหมดเว็บ (WebView) เพื่อใช้งานต่อ"
                android:textColor="#B0B8C8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnBrowseRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/tv_nav_button_bg"
                android:backgroundTint="@color/accent_red"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="ลองใหม่อีกครั้ง"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBrowseOpenWeb"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/tv_nav_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🌐 เปิดโหมดเว็บ"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Quick Search Overlay -->
        <LinearLayout
            android:id="@+id/browseSearchOverlay"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tv_search_dialog_bg"
            android:elevation="30dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 ค้นหาซีรี่ย์ (Search Drama)"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/browseSearchInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="#202534"
                android:hint="พิมพ์ชื่อเรื่องที่ต้องการดู..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/white"
                android:textColorHint="#8892A8"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCancelBrowseSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_nav_button_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="ยกเลิก"
                    android:textColor="#B0B8C8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnSubmitBrowseSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/tv_nav_button_bg"
                    android:backgroundTint="@color/accent_red"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="ค้นหาเลย"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
