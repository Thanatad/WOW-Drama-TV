<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: red glow border like the WebView grid -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A1F2E" />
            <stroke android:width="3dp" android:color="#E50914" />
        </shape>
    </item>
    <!-- Default: dark card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#141824" />
            <stroke android:width="2dp" android:color="#232838" />
        </shape>
    </item>
</selector>
